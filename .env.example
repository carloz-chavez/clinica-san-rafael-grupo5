# Copiar a .env (el archivo .env NO se sube al repositorio)

# Base de datos (Carlos define estos valores en docker-compose.yml)
BASE_DATOS_URL=postgresql://clinica:clinica@localhost:5433/clinica_san_rafael

# Seguridad (Angel)
CLAVE_SECRETA_JWT=cambiar-por-un-valor-largo-y-aleatorio
EXPIRACION_TOKEN_MINUTOS=60

# Autenticacion simulada: SOLO para desarrollar antes de que exista el login real (HU09).
# Con "true", todas las rutas protegidas usan un usuario ficticio con el rol indicado.
# Cambiar ROL_SIMULADO a ADMISION, MEDICO o ADMINISTRADOR para probar los 403.
ENTORNO=local
# En produccion declarar ENTORNO=produccion; rechaza el modo simulado.
AUTENTICACION_SIMULADA=false
ROL_SIMULADO=MEDICO

# Origenes del frontend permitidos por CORS (separados por comas)
ORIGENES_PERMITIDOS=http://localhost:5173
